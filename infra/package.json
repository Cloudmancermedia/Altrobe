{
  "name": "altrobe-infra",
  "private": true,
  "description": "AWS infrastructure for the hosted Altrobe site (AWS CDK). See docs/deployment.md.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth --quiet",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "synth:offline": "CDK_DEFAULT_ACCOUNT=123456789012 CDK_OUTDIR=cdk.out tsx src/app.ts"
  },
  "dependencies": {
    "aws-cdk-lib": "2.274.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "@aws-sdk/client-ssm": "^3.1156.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^26.6.5",
    "aws-cdk": "2.1146.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
